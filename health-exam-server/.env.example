# health-exam-server environment variables

# Database
HEALTHEXAM_DB="Host=localhost;Port=5432;Database=hos_health_exam;User ID=postgres;Password=postgres;"

# IAM Authentication & Internal Secrets
SECRET_KEY=your_jwt_secret_key_at_least_32_characters
SECRET_ISSUER=DHS
SECRET_INTER=your_internal_service_shared_secret

# Form-Server Integration (legacy)
FORM_SERVER_BASE_URL=http://localhost:9910
HEALTH_EXAM_DOCTYPE_ID=990001
HEALTHEXAM_RECONCILE_INTERVAL_MINUTES=10

# HIS EMR Integration (KSK-TREN18TUOI)
HIS_EMR_ENABLED=false
HIS_EMR_BASE_URL=https://his.example.internal
HIS_EMR_TIMEOUT_SECONDS=10
HIS_EMR_CREDENTIAL_HEADER=Authorization
HIS_EMR_DEFINITION_CACHE_SECONDS=300
HIS_EMR_KSK_DEPARTMENT_ID=0
HIS_EMR_KSK_DEPARTMENT_CODE=

# Ký số KSK — sign-server + ssm-server + MinIO
SSM_BASE_URL=http://ssm-server:9930
SIGN_SERVER_BASE_URL=http://sign-server:9940
SIGN_SERVER_TIMEOUT_SECONDS=60
MINIO_PATH=minio:9000
MINIO_USERNAME=
MINIO_PASS=
MINIO_BUCKET_HEALTH_EXAM=health-exam
MINIO_SSL=false
MINIO_SKIP_CERT_VALIDATION=false

